<!-- JAVASCRIPT LOGIC -->
<script>
  // 1. Mobile Menu Toggle
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileIcon = document.getElementById('mobile-menu-icon');

  if (mobileToggle && mobileMenu) {
    mobileToggle.addEventListener('click', () => {
      const isExpanded = !mobileMenu.classList.contains('hidden');
      if (isExpanded) {
        mobileMenu.classList.add('hidden');
        if (mobileIcon) mobileIcon.textContent = 'menu';
      } else {
        mobileMenu.classList.remove('hidden');
        if (mobileIcon) mobileIcon.textContent = 'close';
      }
    });
  }

  // Close mobile menu upon clicking any mobile nav link
  document.querySelectorAll('.mobile-nav-item').forEach(link => {
    link.addEventListener('click', () => {
      if (mobileMenu) mobileMenu.classList.add('hidden');
      if (mobileIcon) mobileIcon.textContent = 'menu';
    });
  });

  // 2. Interactive Digital Letter Toggle
  function toggleLetter() {
    const letter = document.getElementById('letter-content');
    const cover = document.getElementById('envelope-cover');
    if (!letter || !cover) return;

    if (letter.classList.contains('hidden')) {
      letter.classList.remove('hidden');
      letter.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      letter.classList.add('hidden');
      cover.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  // 3. Client-Side Image Picker for Photo Placeholder
  const photoInput = document.getElementById('photo-file-input');
  const partnerPhoto = document.getElementById('partner-photo');

  if (photoInput && partnerPhoto) {
    photoInput.addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          partnerPhoto.src = event.target.result;
        };
        reader.readAsDataURL(file);
      }
    });
  }

  // 4. Smooth Scrolling for all internal anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const targetId = this.getAttribute('href');
      if (!targetId || targetId === '#') return;
      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        e.preventDefault();
        targetElement.scrollIntoView({ behavior: 'smooth' });
        history.pushState(null, null, targetId);
      }
    });
  });

  // 5. Active Navigation Scroll Spy using IntersectionObserver
  const navItems = document.querySelectorAll('#desktop-nav .nav-item, #mobile-menu .mobile-nav-item');
  const monitoredSectionIds = [
    'home',
    'my-letter',
    'eight-months',
    'things-i-love',
    'learning-to-love',
    'my-promises',
    'until-i-hold-you'
  ];

  const observerSections = monitoredSectionIds
    .map(id => document.getElementById(id))
    .filter(Boolean);

  const spyObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        navItems.forEach(item => {
          const target = item.getAttribute('data-nav-target');
          if (target === id) {
            if (item.classList.contains('mobile-nav-item')) {
              item.classList.add('text-primary', 'bg-secondary-container/40');
              item.classList.remove('text-on-surface-variant');
            } else {
              item.classList.add('bg-secondary-container', 'text-on-secondary-container', 'font-medium', 'shadow-[0_0_15px_rgba(244,182,194,0.15)]');
              item.classList.remove('text-on-surface-variant', 'hover:bg-surface-container-high');
            }
          } else {
            if (item.classList.contains('mobile-nav-item')) {
              item.classList.remove('text-primary', 'bg-secondary-container/40');
              item.classList.add('text-on-surface-variant');
            } else {
              item.classList.remove('bg-secondary-container', 'text-on-secondary-container', 'font-medium', 'shadow-[0_0_15px_rgba(244,182,194,0.15)]');
              item.classList.add('text-on-surface-variant');
            }
          }
        });
      }
    });
  }, {
    rootMargin: '-20% 0px -60% 0px',
    threshold: 0.1
  });

  observerSections.forEach(sec => spyObserver.observe(sec));

  // 6. Audio Player Controller for Local MP3 (Unified with Bottom Floating Bar)
  (function initLoveAudio() {
    const audio = document.getElementById('loveAudio');
    if (!audio) return;

    const playBtn = document.getElementById('player-play-btn');
    const playIcon = document.getElementById('player-play-icon');
    const playText = document.getElementById('player-play-text');
    const progressBar = document.getElementById('progressBar');
    const curTimeDisplay = document.getElementById('currentTimeDisplay');
    const durTimeDisplay = document.getElementById('durationDisplay');
    const muteBtn = document.getElementById('player-mute-btn');
    const muteIcon = document.getElementById('player-mute-icon');
    const volSlider = document.getElementById('player-volume-slider');
    const errorBanner = document.getElementById('audio-error-banner');
    const cardWaveBars = document.querySelectorAll('.card-wave');

    const bottomPlayBtn = document.getElementById('bottom-play-btn');
    const bottomPlayIcon = document.getElementById('bottom-play-icon');
    const bottomTimeDisplay = document.getElementById('bottom-time-display');
    const bottomWaveBars = document.querySelectorAll('.bottom-wave');
    const bottomVolFill = document.getElementById('bottom-vol-fill');

    function formatTime(s) {
      if (isNaN(s) || s < 0) return '00:00';
      const m = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
    }

    function setVisualizerState(isPlaying) {
      if (playIcon) playIcon.textContent = isPlaying ? 'pause' : 'play_arrow';
      if (playText) playText.textContent = isPlaying ? 'Pause Song' : 'Play Song';
      if (bottomPlayIcon) bottomPlayIcon.textContent = isPlaying ? 'pause' : 'play_arrow';

      cardWaveBars.forEach((bar, idx) => {
        if (isPlaying) {
          bar.classList.add(idx % 2 === 0 ? 'animate-wave-1' : 'animate-wave-2');
        } else {
          bar.classList.remove('animate-wave-1', 'animate-wave-2', 'animate-wave-3', 'animate-wave-4');
        }
      });

      bottomWaveBars.forEach((bar, idx) => {
        if (isPlaying) {
          bar.classList.add(idx % 2 === 0 ? 'animate-wave-1' : 'animate-wave-2');
        } else {
          bar.classList.remove('animate-wave-1', 'animate-wave-2', 'animate-wave-3', 'animate-wave-4');
        }
      });
    }

    async function togglePlayback() {
      if (audio.paused) {
        try {
          await audio.play();
          setVisualizerState(true);
        } catch (err) {
          console.warn('Playback error or blocked by browser:', err);
          setVisualizerState(false);
          if (errorBanner) errorBanner.classList.remove('hidden');
        }
      } else {
        audio.pause();
        setVisualizerState(false);
      }
    }

    if (playBtn) playBtn.addEventListener('click', togglePlayback);
    if (bottomPlayBtn) bottomPlayBtn.addEventListener('click', togglePlayback);

    audio.addEventListener('play', () => {
      setVisualizerState(true);
      if (errorBanner) errorBanner.classList.add('hidden');
    });
    audio.addEventListener('pause', () => setVisualizerState(false));
    audio.addEventListener('ended', () => {
      setVisualizerState(false);
      if (progressBar) progressBar.value = 0;
    });

    audio.addEventListener('timeupdate', () => {
      const cur = audio.currentTime;
      const dur = audio.duration || 255;
      const pct = (cur / dur) * 100;
      if (progressBar && !progressBar.matches(':active')) {
        progressBar.value = pct;
      }
      if (curTimeDisplay) curTimeDisplay.textContent = formatTime(cur);
      if (durTimeDisplay && !isNaN(audio.duration)) durTimeDisplay.textContent = formatTime(audio.duration);
      if (bottomTimeDisplay) bottomTimeDisplay.textContent = `${formatTime(cur)} / ${formatTime(dur)}`;
    });

    audio.addEventListener('loadedmetadata', () => {
      if (durTimeDisplay && audio.duration) durTimeDisplay.textContent = formatTime(audio.duration);
      if (bottomTimeDisplay && audio.duration) bottomTimeDisplay.textContent = `00:00 / ${formatTime(audio.duration)}`;
    });

    audio.addEventListener('error', () => {
      setVisualizerState(false);
      if (errorBanner) errorBanner.classList.remove('hidden');
    });

    // Seeking scrub
    if (progressBar) {
      const seekAudio = () => {
        const dur = audio.duration || 255;
        const target = (parseFloat(progressBar.value) / 100) * dur;
        audio.currentTime = target;
        if (curTimeDisplay) curTimeDisplay.textContent = formatTime(target);
      };
      progressBar.addEventListener('input', seekAudio);
      progressBar.addEventListener('change', seekAudio);
    }

    // Volume Slider
    if (volSlider) {
      volSlider.addEventListener('input', (e) => {
        const val = parseFloat(e.target.value) / 100;
        audio.volume = val;
        audio.muted = (val === 0);
        if (muteIcon) muteIcon.textContent = val === 0 ? 'volume_off' : 'volume_up';
        if (bottomVolFill) bottomVolFill.style.width = `${val * 100}%`;
      });
    }

    // Mute Toggle
    if (muteBtn) {
      muteBtn.addEventListener('click', () => {
        audio.muted = !audio.muted;
        if (muteIcon) muteIcon.textContent = audio.muted ? 'volume_off' : 'volume_up';
        if (volSlider && audio.muted) volSlider.value = 0;
        else if (volSlider) volSlider.value = audio.volume * 100;
      });
    }

    // Initial audio volume configuration
    audio.volume = 0.85;

    // Graceful Autoplay Handling on Page Load
    window.addEventListener('load', () => {
      audio.play().then(() => {
        setVisualizerState(true);
      }).catch(() => {
        // Autoplay prevented by browser policies; keep player ready with visible Play button
        setVisualizerState(false);
      });
    });
  })();
</script>


